# ─────────────────────────────────────────────────
# V2Hub Mini App — environment configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# Application
V2HUB_APP_TITLE="V2Hub Panel"
V2HUB_APP_VERSION="1.0.0"
V2HUB_LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR

# Fixed API URL (optional)
# When set, the mini-app always uses this URL and users cannot change it.
# Leave empty to let users enter their own API URL in the connect dialog.
# V2HUB_FIXED_API_URL=https://v2hub.example.com

# CORS
# In production set this to your actual domain(s), not "*"
V2HUB_CORS_ORIGINS=["*"]
V2HUB_CORS_ALLOW_CREDENTIALS="true"
